e=10;fontColor=#1F2328;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1016.0" y="522.0" width="330.0" height="14.0" as="geometry"/></mxCell><mxCell id="c78" value="heights reserved from the API before paint" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#C9D1D9;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1016.0" y="542.0" width="330.0" height="14.0" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B26A00;dashed=0;fontSize=11;fontColor=#1F2328;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="636.0" width="1340.0" height="116.0" as="geometry"/></mxCell><mxCell id="c80" value="Seams — where this changes for production" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#B26A00;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="650.0" width="400.0" height="18.0" as="geometry"/></mxCell><mxCell id="c81" value="useReview" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1F2328;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="680.0" width="300.0" height="16.0" as="geometry"/></mxCell><mxCell id="c82" value="swap the fetch for the real endpoint;&lt;br/&gt;the validator stays" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#C9D1D9;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56.0" y="708.0" width="310.0" height="30.0" as="geometry"/></mxCell><mxCell id="c83" value="Issue.page" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1F2328;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="386.0" y="680.0" width="300.0" height="16.0" as="geometry"/></mxCell><mxCell id="c84" value="add bounding boxes and the markers&lt;br/&gt;move onto the page" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#C9D1D9;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="386.0" y="708.0" width="310.0" height="30.0" as="geometry"/></mxCell><mxCell id="c85" value="CANVAS_WINDOW" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1F2328;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="716.0" y="680.0" width="300.0" height="16.0" as="geometry"/></mxCell><mxCell id="c86" value="a page count today; becomes geometry&lt;br/&gt;for 500-page documents" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#C9D1D9;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="716.0" y="708.0" width="310.0" height="30.0" as="geometry"/></mxCell><mxCell id="c87" value="submit" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1F2328;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1046.0" y="680.0" width="300.0" height="16.0" as="geometry"/></mxCell><mxCell id="c88" value="a real mutation, optimistic state,&lt;br/&gt;and a conflict path" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#C9D1D9;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1046.0" y="708.0" width="310.0" height="30.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>