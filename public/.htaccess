# Apache config for vera.andrewbaldock.com
#
# Lives in public/ so Vite copies it into dist/ verbatim on every build — it is
# deployment configuration, and deployment configuration that has to be
# remembered separately is deployment configuration that gets forgotten.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # SPA deep-link fallback. Client-side routing means /documents and
  # /reviews/:id are not files on disk, so a hard refresh or a pasted link
  # would 404 without this.
  #
  # The two conditions matter more than the rewrite does: a request that IS a
  # real file or directory must be served as itself. Rewriting everything would
  # hand index.html to a request for a missing hashed bundle — HTML with a 200
  # status, which the browser then tries to parse as JavaScript. That is the
  # "Unexpected token '<'" white screen, and it only appears after a deploy,
  # which is the worst possible time to be debugging it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# index.html must never be cached: it is the only file whose name doesn't change
# between deploys, and it carries the references to the hashed assets. A stale
# copy points at bundles that no longer exist.
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</Files>

# Cache hard, but ONLY files whose name contains a build hash — those are
# immutable by construction, since changing the content changes the name.
#
# Deliberately not a blanket rule on .png/.svg: the PWA icons and the favicon
# keep stable names across builds, and a year of immutable caching on those
# means a corrected icon never reaches anyone who has already visited.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# The sample document and the mock are fixtures, not content. Keep them out of
# search results and AI crawlers — this is a take-home, not a publication.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
